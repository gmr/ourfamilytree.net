# Required
DATABASE_URL=postgres://oft:devpassword@localhost:5442/oft
# Public origin of the site, no trailing slash (OAuth redirects and MCP metadata use it)
BASE_URL=http://localhost:8080

# Who may sign in to the MCP server: comma-separated emails. Nobody else can, even with a
# Google account. Remove an address and restart to cut off its access at once.
ADMIN_EMAILS=dev@localhost

# MCP sign-in (Google OAuth client, "Web application"; redirect URI: $BASE_URL/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only: sign every MCP login in as this administrator, without Google.
# Refused unless BASE_URL is localhost; the email must also be in ADMIN_EMAILS.
DEV_LOGIN_EMAIL=

# Optional
PORT=8080
RUST_LOG=oft_api=info,tower_http=warn
